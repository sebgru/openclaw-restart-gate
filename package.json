{
  "name": "docker-restart-gate",
  "version": "1.0.0",
  "private": false,
  "description": "Allowlist-only, authenticated Docker restart gateway with cooldowns.",
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:cov": "node --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90 --test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
